--- /dev/null
+++ b/Common/sources/oosSnapshotIdentity.js
@@ -0,0 +1,27 @@
+/* OrganisationOS addition; SPDX-License-Identifier: AGPL-3.0-only */
+'use strict';
+const crypto = require('crypto');
+exports.create = function(baseSha256) {
+  let count = 0;
+  let reliable = typeof baseSha256 === 'string' && /^[a-f0-9]{64}$/.test(baseSha256);
+  let finished = false;
+  const hash = crypto.createHash('sha256');
+  hash.update('organisationos-converted-changes-v1\n' + String(baseSha256) + '\n');
+  return {
+    append(index, data) {
+      if (finished) throw new Error('Snapshot identity already finished');
+      const id = Number(index);
+      if (!Number.isSafeInteger(id) || id !== count || (!Buffer.isBuffer(data) && typeof data !== 'string')) reliable = false;
+      const bytes = Buffer.isBuffer(data) ? data : Buffer.from(typeof data === 'string' ? data : '', 'utf8');
+      hash.update(String(id) + ':' + bytes.length + ':');
+      hash.update(bytes);
+      count++;
+    },
+    finish(ordinaryChanges) {
+      if (finished) throw new Error('Snapshot identity already finished');
+      finished = true;
+      return {schema: 'organisationos-converted-changes-v1', reliable: reliable && ordinaryChanges === true,
+        baseSha256, changeCount: count, changesSha256: hash.digest('hex')};
+    }
+  };
+};
