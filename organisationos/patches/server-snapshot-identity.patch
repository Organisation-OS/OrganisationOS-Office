--- /dev/null
+++ b/Common/sources/oosSnapshotIdentity.js
@@ -0,0 +1,37 @@
+/* OrganisationOS addition; SPDX-License-Identifier: AGPL-3.0-only */
+'use strict';
+const crypto = require('crypto');
+const fs = require('fs');
+exports.readSource = function(file) {
+  try {
+    const stat = fs.lstatSync(file);
+    if (!stat.isFile() || stat.size > 256) return null;
+    const source = JSON.parse(fs.readFileSync(file, 'utf8'));
+    if (source.schema !== 'organisationos-source-v1' || typeof source.sourceSha256 !== 'string' || !/^[a-f0-9]{64}$/.test(source.sourceSha256)) return null;
+    return source.sourceSha256;
+  } catch (_) { return null; }
+};
+exports.create = function(baseSha256, sourceSha256) {
+  let count = 0;
+  let reliable = [baseSha256, sourceSha256].every(value => typeof value === 'string' && /^[a-f0-9]{64}$/.test(value));
+  let finished = false;
+  const hash = crypto.createHash('sha256');
+  hash.update('organisationos-converted-changes-v2\n' + String(sourceSha256) + '\n' + String(baseSha256) + '\n');
+  return {
+    append(index, data) {
+      if (finished) throw new Error('Snapshot identity already finished');
+      const id = Number(index);
+      if (!Number.isSafeInteger(id) || id !== count || (!Buffer.isBuffer(data) && typeof data !== 'string')) reliable = false;
+      const bytes = Buffer.isBuffer(data) ? data : Buffer.from(typeof data === 'string' ? data : '', 'utf8');
+      hash.update(String(id) + ':' + bytes.length + ':');
+      hash.update(bytes);
+      count++;
+    },
+    finish(ordinaryChanges) {
+      if (finished) throw new Error('Snapshot identity already finished');
+      finished = true;
+      return {schema: 'organisationos-converted-changes-v2', reliable: reliable && ordinaryChanges === true,
+        sourceSha256, baseSha256, changeCount: count, changesSha256: hash.digest('hex')};
+    }
+  };
+};
